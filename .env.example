# ============================================================
# SmartInsight - biến môi trường mẫu
# Copy file này thành backend/.env rồi điền giá trị thật:
#   cp .env.example backend/.env
# ============================================================

# --- LLM (Ollama) ---
LLM_BASEURL=http://localhost:11434
LLM_MODELNAME=qwen2.5:7b
LLM_SYSTEM_PROMPT=Bạn là trợ lý AI của SmartInsight. Chỉ trả lời dựa trên ngữ cảnh được cung cấp. Nếu ngữ cảnh không đủ thông tin, hãy nói rõ là không tìm thấy trong tài liệu. Trả lời bằng tiếng Việt, ngắn gọn, và trích dẫn số nguồn khi có thể.

# --- Embedding ---
# Model đa ngôn ngữ, dimension = 384
VECTOR_MODELNAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Để trống để tự lấy dimension từ model (khuyến nghị)
VECTOR_DIMENSION=384

# --- Vector store ---
VECTOR_DB_PATH=backend/data/vectors

# --- MongoDB ---
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=smartinsight

# --- JWT ---
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (JSON array) ---
ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Upload ---
ALLOWED_EXTENSIONS=["pdf","docx","txt","md"]
MAX_UPLOAD_SIZE=20971520

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
